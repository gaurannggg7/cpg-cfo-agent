# .env.example — Copy relevant sections to the appropriate .env file.
# Never commit actual secrets to git.

# ── backend/.env ─────────────────────────────────────────────────────────────

# Groq inference API key (required for the LangGraph pipeline)
GROQ_API_KEY=your_groq_api_key_here

# Kafka broker address (default: localhost:9092 for local dev)
# Docker Compose: kafka:9092
# Kubernetes:     kafka-service:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Port the Prometheus metrics HTTP server listens on (monitoring.py)
METRICS_PORT=9090

# Firebase Admin SDK — service account JSON for evaluation.py → Firestore writes
# Download from Firebase Console → Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# ── Firebase ID-token verification on POST /analyze (auth.py) ────────────────
# Credentials are resolved in this order: FIREBASE_SERVICE_ACCOUNT_BASE64,
# then GOOGLE_APPLICATION_CREDENTIALS, then FIREBASE_PROJECT_ID.
#
# PRODUCTION (Render): base64-encoded service-account JSON on a single line.
# Generate it locally with:
#   base64 -i /path/to/firebase-service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json

# LOCAL DEV: project id alone is enough to verify ID tokens — the signing
# certificates are public, so no service-account key is needed just to verify.
FIREBASE_PROJECT_ID=cpg-cfo-agent

# ── root .env (read by docker-compose for the prometheus-config service) ─────

# Grafana Cloud remote_write target — from Connections → Hosted Prometheus metrics
# → "From my local Prometheus server" → Directly
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-xx-x.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USERNAME=your_instance_id
GRAFANA_CLOUD_API_KEY=glc_your_access_policy_token

# ── services/gateway/.env (or export before running) ─────────────────────────

# gRPC server port
GRPC_GATEWAY_PORT=50051

# ── frontend/.env.local ───────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
